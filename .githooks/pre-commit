#!/bin/sh
# Para q git lo use hay q correr una vez:  ./gradlew installGitHooks

echo "pre-commit: corriendo ktlintCheck y detekt..."

if ! ./gradlew ktlintCheck detekt --console=plain --quiet; then
    echo "pre-commit: hay errores de estilo o de analisis estatico, el commit se cancelo."
    echo "el formato se arregla solo con:  ./gradlew ktlintFormat"
    echo "los de detekt hay que mirarlos uno por uno."
    exit 1
fi

echo "pre-commit: estilo y analisis estatico ok"
